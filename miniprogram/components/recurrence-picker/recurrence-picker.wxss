.recurrence-picker {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.picker-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
}

.picker-panel {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 16rpx 16rpx 0 0;
  padding: 0 32rpx;
  padding-bottom: env(safe-area-inset-bottom);
  max-height: 85vh;
  overflow-y: auto;
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-cancel {
  font-size: 28rpx;
  color: #999;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}

.picker-confirm {
  font-size: 28rpx;
  color: #4a90d9;
  font-weight: 600;
}

/* Type grid */
.type-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 28rpx 0;
}

.type-item {
  padding: 16rpx 36rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  background: #f5f6f8;
  color: #666;
}

.type-item.active {
  background: #4a90d9;
  color: #fff;
  font-weight: 600;
}

/* Option rows */
.option-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-top: 1rpx solid #f5f5f5;
}

.option-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
  display: block;
}

.option-sublabel {
  font-size: 24rpx;
  color: #999;
  margin: 16rpx 0 12rpx;
  display: block;
}

.option-section {
  padding: 20rpx 0;
  border-top: 1rpx solid #f5f5f5;
}

/* Interval */
.interval-control {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.interval-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f5f6f8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #4a90d9;
  font-weight: 600;
}

.interval-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  min-width: 48rpx;
  text-align: center;
}

.interval-unit {
  font-size: 26rpx;
  color: #999;
}

/* Weekday grid */
.weekday-grid {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.weekday-item {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  background: #f5f6f8;
  color: #666;
}

.weekday-item.active {
  background: #4a90d9;
  color: #fff;
  font-weight: 600;
}

/* Day input */
.day-input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.day-input {
  width: 120rpx;
  height: 72rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

.day-unit {
  font-size: 26rpx;
  color: #999;
}

/* Mode buttons */
.mode-row {
  display: flex;
  gap: 16rpx;
}

.mode-btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f5f6f8;
  text-align: center;
  font-size: 26rpx;
  color: #666;
}

.mode-btn.active {
  background: #4a90d9;
  color: #fff;
  font-weight: 600;
}

/* Week grid */
.week-grid {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.week-item {
  padding: 16rpx 36rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  background: #f5f6f8;
  color: #666;
}

.week-item.active {
  background: #4a90d9;
  color: #fff;
  font-weight: 600;
}

/* Month grid */
.month-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.month-item {
  width: calc(25% - 12rpx);
  padding: 16rpx 0;
  border-radius: 12rpx;
  text-align: center;
  font-size: 26rpx;
  background: #f5f6f8;
  color: #666;
}

.month-item.active {
  background: #4a90d9;
  color: #fff;
  font-weight: 600;
}
