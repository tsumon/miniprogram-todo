.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  animation: fadeIn 0.4s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.empty-icon {
  margin-bottom: 32rpx;
}

.icon-clipboard {
  width: 120rpx;
  height: 140rpx;
  position: relative;
}

.clip-top {
  width: 48rpx;
  height: 12rpx;
  background: #d0d6e0;
  border-radius: 6rpx;
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  z-index: 2;
}

.clip-body {
  width: 100rpx;
  height: 120rpx;
  background: #eef0f4;
  border-radius: 12rpx;
  position: absolute;
  top: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 24rpx 20rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.clip-line {
  height: 8rpx;
  background: #d0d6e0;
  border-radius: 4rpx;
  width: 100%;
}

.clip-line.short {
  width: 60%;
}

.empty-text {
  font-size: 30rpx;
  color: #888;
  font-weight: 500;
}

.empty-subtext {
  font-size: 24rpx;
  color: #bbb;
  margin-top: 12rpx;
}
