.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.search-icon {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid #bbb;
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.search-icon::after {
  content: '';
  position: absolute;
  bottom: -6rpx;
  right: -6rpx;
  width: 12rpx;
  height: 3rpx;
  background: #bbb;
  transform: rotate(45deg);
  border-radius: 2rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #2c2c2a;
  height: 60rpx;
}

.search-clear {
  font-size: 26rpx;
  color: #4A90D9;
  padding: 0 8rpx;
  flex-shrink: 0;
}

.tabs {
  display: flex;
  background: #fff;
  padding: 0 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #888;
  position: relative;
}

.tab-item.active {
  color: #4A90D9;
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  width: 48rpx;
  height: 6rpx;
  background: #4A90D9;
  border-radius: 3rpx;
}

.task-group {
  margin-top: 24rpx;
  padding: 0 32rpx;
}

.group-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
  padding: 0 4rpx;
}

.group-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #666;
}

.group-count {
  font-size: 22rpx;
  color: #aaa;
}

.mx-32 {
  margin-left: 32rpx;
  margin-right: 32rpx;
  margin-top: 24rpx;
}

.task-list {
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* FAB */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 180rpx;
  width: 100rpx;
  height: 100rpx;
  background: #4A90D9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 217, 0.4);
  z-index: 100;
  transition: transform 0.15s ease;
}

.fab:active {
  transform: scale(0.92);
}

.fab-icon {
  width: 40rpx;
  height: 40rpx;
  position: relative;
}

.fab-icon::before,
.fab-icon::after {
  content: '';
  position: absolute;
  background: #fff;
  border-radius: 4rpx;
  top: 50%;
  left: 50%;
}

.fab-icon::before {
  width: 36rpx;
  height: 6rpx;
  transform: translate(-50%, -50%);
}

.fab-icon::after {
  width: 6rpx;
  height: 36rpx;
  transform: translate(-50%, -50%);
}
