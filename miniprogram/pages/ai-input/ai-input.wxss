.container {
  padding: 24rpx;
  padding-bottom: 200rpx;
}

/* No config banner */
.no-config-banner {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #fff8e1, #fff3cd);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
}

.banner-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #ff9800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  position: relative;
}
.banner-icon::before {
  content: '!';
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
}

.banner-text {
  flex: 1;
}

.banner-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #e65100;
  display: block;
}

.banner-desc {
  font-size: 24rpx;
  color: #bf7100;
  display: block;
  margin-top: 4rpx;
}

.banner-btn {
  padding: 12rpx 28rpx;
  background: #ff9800;
  color: #fff;
  font-size: 24rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
}

/* Input section */
.input-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.text-input {
  width: 100%;
  min-height: 160rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: #222;
}

.input-placeholder {
  color: #bbb;
  font-size: 28rpx;
}

.input-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-voice {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  background: #f5f6f8;
  border-radius: 28rpx;
}

.action-voice.recording {
  background: #fee;
}

.voice-icon {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #4a90d9;
  position: relative;
}
.voice-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 12rpx;
  height: 16rpx;
  background: #fff;
  border-radius: 6rpx 6rpx 6rpx 6rpx;
}

.voice-icon.recording-anim {
  background: #e24b4a;
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.3); }
}

.voice-label {
  font-size: 26rpx;
  color: #666;
}

.action-voice.recording .voice-label {
  color: #e24b4a;
}

.action-clear {
  margin-left: auto;
  padding: 14rpx 24rpx;
  font-size: 26rpx;
  color: #999;
}

.action-parse {
  padding: 14rpx 36rpx;
  background: #4a90d9;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 28rpx;
}

.action-parse.disabled {
  background: #ccc;
}

/* Recording overlay */
.recording-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.recording-waves {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 120rpx;
}

.wave-bar {
  width: 8rpx;
  height: 60rpx;
  background: #4a90d9;
  border-radius: 4rpx;
  animation: wave 0.8s infinite ease-in-out;
}

@keyframes wave {
  0%, 100% { height: 30rpx; }
  50% { height: 100rpx; }
}

.recording-text {
  color: #fff;
  font-size: 30rpx;
  margin-top: 32rpx;
}

.recording-stop {
  margin-top: 40rpx;
  padding: 20rpx 60rpx;
  background: #e24b4a;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
}

/* Processing overlay */
.processing-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.processing-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #e0e0e0;
  border-top-color: #4a90d9;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.processing-text {
  margin-top: 28rpx;
  font-size: 28rpx;
  color: #666;
}

/* Examples */
.examples-section {
  margin-top: 40rpx;
}

.examples-title {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 20rpx;
  display: block;
}

.examples-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.example-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.03);
}

.example-item:active {
  background: #f9f9f9;
}

.example-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #4a90d9, #6bb5e8);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.example-text {
  font-size: 26rpx;
  color: #555;
}

/* Result section */
.result-section {
  margin-top: 8rpx;
}

.result-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.result-badge {
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, #4a90d9, #6bb5e8);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 8rpx;
}

.result-hint {
  font-size: 24rpx;
  color: #999;
}

.edit-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.edit-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 16rpx;
}

.edit-note {
  width: 100%;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  min-height: 60rpx;
}

.edit-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-top: 1rpx solid #f5f5f5;
}

.edit-row:first-child {
  border-top: none;
}

.edit-label {
  font-size: 28rpx;
  color: #333;
  width: 140rpx;
  flex-shrink: 0;
}

.edit-value {
  font-size: 28rpx;
  color: #222;
  flex: 1;
  text-align: right;
}

.edit-value.placeholder {
  color: #bbb;
}

.edit-arrow {
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #ccc;
  border-top: 3rpx solid #ccc;
  transform: rotate(45deg);
  margin-left: 12rpx;
}

.priority-options {
  display: flex;
  gap: 12rpx;
  margin-left: auto;
}

.priority-opt {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: #f5f6f8;
  font-size: 24rpx;
  color: #666;
}

.priority-opt.active {
  background: #e8f0fc;
  color: #4a90d9;
  font-weight: 600;
}

.priority-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.category-options {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-left: auto;
  justify-content: flex-end;
}

.category-opt {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  border: 2rpx solid transparent;
  background: #f5f6f8;
  font-size: 24rpx;
  color: #666;
}

.category-opt.active {
  background: #fff;
}

.cat-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

/* Birthday */
.birthday-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-left: auto;
}

.birthday-name-input {
  width: 160rpx;
  font-size: 26rpx;
  text-align: right;
  color: #222;
}

.calendar-toggle {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  background: #f5f6f8;
  font-size: 24rpx;
  color: #666;
}

.calendar-toggle.lunar {
  background: #fff3e0;
  color: #e65100;
}

/* Actions */
.result-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
  padding: 0 8rpx;
}

.btn-discard {
  flex: 1;
  padding: 28rpx 0;
  text-align: center;
  background: #f5f6f8;
  color: #666;
  font-size: 30rpx;
  border-radius: 16rpx;
}

.btn-create {
  flex: 2;
  padding: 28rpx 0;
  text-align: center;
  background: #4a90d9;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
}

.btn-create:active {
  background: #3a7bc8;
}
