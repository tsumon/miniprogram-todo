.header {
  padding: 40rpx 32rpx 24rpx;
  background: #fff;
}

.header-greeting {
  font-size: 48rpx;
  font-weight: 700;
  color: #2c2c2a;
  line-height: 1.3;
}

.header-date {
  font-size: 26rpx;
  color: #888;
  margin-top: 8rpx;
}

.header-stats {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
  gap: 0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #2c2c2a;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: #eee;
}

.progress-bar {
  display: flex;
  align-items: center;
  padding: 0 32rpx 24rpx;
  background: #fff;
  gap: 16rpx;
}

/* Reminder banner */
.reminder-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 24rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #fff4e6, #ffe9cc);
  border-radius: 20rpx;
}

.reminder-bell {
  font-size: 40rpx;
}

.reminder-banner-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.reminder-banner-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #b25e00;
}

.reminder-banner-sub {
  font-size: 20rpx;
  color: #b07942;
  margin-top: 4rpx;
}

.reminder-banner-arrow {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #b25e00;
  border-top: 3rpx solid #b25e00;
  transform: rotate(45deg);
}

.progress-track {
  flex: 1;
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4A90D9, #1D9E75);
  border-radius: 4rpx;
  transition: width 0.4s ease;
}

.progress-text {
  font-size: 22rpx;
  color: #888;
  flex-shrink: 0;
}

.section {
  margin-top: 24rpx;
  padding: 0 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2c2c2a;
}

.section-count {
  font-size: 24rpx;
  color: #aaa;
  background: #f0f0f0;
  padding: 2rpx 16rpx;
  border-radius: 20rpx;
}

.task-list {
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.task-list task-item:last-child {
  border-bottom: none;
}

.all-done {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.all-done-text {
  font-size: 28rpx;
  color: #1D9E75;
  font-weight: 500;
}

/* FAB */
.fab-group {
  position: fixed;
  right: 40rpx;
  bottom: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  z-index: 100;
}

.fab {
  width: 100rpx;
  height: 100rpx;
  background: #4A90D9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 217, 0.4);
  transition: transform 0.15s ease;
}

.fab:active {
  transform: scale(0.92);
}

.fab-icon {
  width: 40rpx;
  height: 40rpx;
  position: relative;
}

.fab-icon::before,
.fab-icon::after {
  content: '';
  position: absolute;
  background: #fff;
  border-radius: 4rpx;
  top: 50%;
  left: 50%;
}

.fab-icon::before {
  width: 36rpx;
  height: 6rpx;
  transform: translate(-50%, -50%);
}

.fab-icon::after {
  width: 6rpx;
  height: 36rpx;
  transform: translate(-50%, -50%);
}

/* AI FAB */
.fab-ai {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #6a5acd, #4a90d9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(106, 90, 205, 0.35);
  transition: transform 0.15s ease;
}

.fab-ai:active {
  transform: scale(0.92);
}

.fab-ai-text {
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
}
