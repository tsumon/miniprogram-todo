.section {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.title-input {
  font-size: 36rpx;
  font-weight: 600;
  color: #2c2c2a;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.title-placeholder {
  color: #ccc;
  font-weight: 500;
}

.note-input {
  width: 100%;
  font-size: 28rpx;
  color: #666;
  margin-top: 24rpx;
  min-height: 60rpx;
  line-height: 1.6;
}

.note-placeholder {
  color: #ccc;
}

.card-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 0 32rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.card-row:last-child {
  border-bottom: none;
}

.card-label {
  font-size: 30rpx;
  color: #2c2c2a;
  font-weight: 500;
}

.picker-value {
  font-size: 28rpx;
  color: #4A90D9;
}

.priority-options {
  display: flex;
  gap: 16rpx;
}

.priority-option {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  background: #f5f6f8;
  font-size: 24rpx;
  color: #888;
  transition: all 0.2s ease;
}

.priority-option.active {
  background: #E6F1FB;
  color: #185FA5;
  font-weight: 600;
}

.priority-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.quick-dates {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 0 28rpx;
}

.quick-date {
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  background: #f5f6f8;
  font-size: 24rpx;
  color: #666;
  transition: all 0.2s ease;
}

.quick-date.active {
  background: #4A90D9;
  color: #fff;
  font-weight: 500;
}

.time-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.time-clear {
  font-size: 24rpx;
  color: #aaa;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 20rpx 0 28rpx;
}

.category-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 28rpx;
  border-radius: 32rpx;
  background: #f5f6f8;
  font-size: 24rpx;
  color: #666;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.category-item.active {
  background: #fff;
  font-weight: 500;
}

.category-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 24rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
}

.btn-cancel {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f6f8;
  border-radius: 44rpx;
  font-size: 30rpx;
  color: #666;
}

.btn-save {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #4A90D9;
  border-radius: 44rpx;
  font-size: 30rpx;
  color: #fff;
  font-weight: 500;
}

.btn-save:active {
  background: #3A7FC9;
}

/* AI entry */
.ai-entry {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  margin: 0 24rpx 24rpx;
  background: linear-gradient(135deg, #f1ecfe, #f6f1ff);
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(106, 90, 205, 0.1);
}

.ai-entry-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #7b6cf6, #9b8cf0);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ai-entry-text {
  flex: 1;
  font-size: 26rpx;
  color: #6a5acd;
  font-weight: 500;
}

.ai-entry-arrow {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #6a5acd;
  border-top: 3rpx solid #6a5acd;
  transform: rotate(45deg);
}

/* Card arrow */
.card-arrow {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #ccc;
  border-top: 3rpx solid #ccc;
  transform: rotate(45deg);
  margin-left: 12rpx;
}

/* Switch toggle */
.switch-toggle {
  width: 88rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #e0e0e0;
  position: relative;
  transition: background 0.2s;
}

.switch-toggle.on {
  background: #4a90d9;
}

.switch-knob {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff;
  transition: transform 0.2s;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.15);
}

.switch-toggle.on .switch-knob {
  transform: translateX(40rpx);
}

/* Birthday */
.birthday-name {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #222;
}

.calendar-toggle {
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
  background: #f5f6f8;
  font-size: 26rpx;
  color: #666;
}

.calendar-toggle.lunar {
  background: #fff3e0;
  color: #e65100;
}

.birthday-hint {
  font-size: 22rpx;
  color: #999;
  padding: 8rpx 0 20rpx;
  line-height: 1.5;
}

.text-tertiary {
  color: #bbb !important;
}

/* Reminder chips */
.reminder-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 8rpx 0 4rpx;
}

.reminder-chip {
  padding: 14rpx 28rpx;
  border-radius: 12rpx;
  background: #f5f6f8;
  font-size: 24rpx;
  color: #666;
  border: 2rpx solid transparent;
}

.reminder-chip.active {
  background: #eaf3fc;
  border-color: #4a90d9;
  color: #4a90d9;
  font-weight: 600;
}
