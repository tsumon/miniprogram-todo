.container {
  padding-bottom: 160rpx;
}

/* 月份导航 */
.cal-header {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx 16rpx;
  gap: 16rpx;
}

.cal-nav-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f0f1f4;
  color: #555;
  font-size: 44rpx;
  line-height: 60rpx;
  text-align: center;
}

.cal-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #2c2c2a;
}

.cal-today {
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  background: #eaf3fc;
  color: #4a90d9;
  font-size: 24rpx;
  font-weight: 600;
}

/* 星期表头 */
.cal-weekdays {
  display: flex;
  padding: 16rpx 16rpx 8rpx;
}

.cal-weekday {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #888;
}

.cal-weekday.weekend {
  color: #e24b4a;
}

/* 日期网格 */
.cal-grid {
  display: flex;
  flex-wrap: wrap;
  background: #fff;
  margin: 0 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  padding: 12rpx 0;
}

.cal-cell {
  width: 14.28%;
  height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.cal-day {
  font-size: 30rpx;
  color: #2c2c2a;
  font-weight: 500;
}

.cal-cell.out-month .cal-day {
  color: #ccc;
}

.cal-cell.weekend .cal-day {
  color: #e24b4a;
}

.cal-cell.today .cal-day {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  background: #4a90d9;
  color: #fff;
}

.cal-cell.selected:not(.today) .cal-day {
  color: #4a90d9;
  font-weight: 700;
}

.cal-dot {
  margin-top: 6rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #4a90d9;
  color: #fff;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
}

.cal-dot.dot-light {
  background: #fff;
  color: #4a90d9;
}

/* 选中日期任务 */
.selected-section {
  margin-top: 24rpx;
  padding: 0 24rpx;
}

.selected-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.selected-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #2c2c2a;
}

.selected-count {
  font-size: 24rpx;
  color: #999;
}

.task-list {
  border-radius: 24rpx;
  overflow: hidden;
}

.empty-day {
  padding: 80rpx 0;
  text-align: center;
  color: #bbb;
  font-size: 26rpx;
}

/* FAB */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  background: #4a90d9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 217, 0.4);
  z-index: 100;
}

.fab:active {
  transform: scale(0.92);
}

.fab-icon {
  width: 40rpx;
  height: 56rpx;
  position: relative;
}

.fab-icon::before,
.fab-icon::after {
  content: '';
  position: absolute;
  background: #fff;
  border-radius: 4rpx;
  top: 50%;
  left: 50%;
}

.fab-icon::before {
  width: 36rpx;
  height: 6rpx;
  transform: translate(-50%, -50%);
}

.fab-icon::after {
  width: 6rpx;
  height: 36rpx;
  transform: translate(-50%, -50%);
}
