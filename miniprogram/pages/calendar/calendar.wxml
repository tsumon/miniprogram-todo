<view class="container">
  <!-- 月份导航 -->
  <view class="cal-header">
    <view class="cal-nav-btn" bindtap="onPrevMonth">‹</view>
    <view class="cal-title">{{year}}年{{month + 1}}月</view>
    <view class="cal-nav-btn" bindtap="onNextMonth">›</view>
    <view class="cal-today" bindtap="onToday">今天</view>
  </view>

  <!-- 星期表头 -->
  <view class="cal-weekdays">
    <view class="cal-weekday {{item === '日' || item === '六' ? 'weekend' : ''}}" wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="*this">{{item}}</view>
  </view>

  <!-- 日期网格 -->
  <view class="cal-grid">
    <view
      wx:for="{{weeks}}"
      wx:key="date"
      class="cal-cell {{item.inMonth ? '' : 'out-month'}} {{item.isToday ? 'today' : ''}} {{item.isSelected ? 'selected' : ''}}"
      data-date="{{item.date}}"
      bindtap="onSelectDay"
    >
      <text class="cal-day">{{item.day}}</text>
      <view wx:if="{{item.count > 0}}" class="cal-dot {{item.isSelected ? 'dot-light' : ''}}">{{item.count > 9 ? '9+' : item.count}}</view>
    </view>
  </view>

  <!-- 选中日期任务 -->
  <view class="selected-section">
    <view class="selected-header">
      <text class="selected-label">{{selectedLabel}}</text>
      <text class="selected-count">{{tasksForSelected.length}} 个任务</text>
    </view>

    <view wx:if="{{tasksForSelected.length > 0}}" class="task-list card">
      <task-item
        wx:for="{{tasksForSelected}}"
        wx:key="id"
        task="{{item}}"
        show-category="{{true}}"
        bind:toggle="onToggleTask"
        bind:tap="onTapTask"
        bind:delete="onDeleteTask"
      />
    </view>

    <view wx:else class="empty-day">
      <text>这一天还没有安排任务</text>
    </view>
  </view>

  <!-- FAB -->
  <view class="fab" bindtap="onCreate">
    <view class="fab-icon"></view>
  </view>
</view>
